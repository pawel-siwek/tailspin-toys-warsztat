---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import GameFilters from '../components/GameFilters.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Wesprzyj swoją nową ulubioną grę!">
  <div class="py-8">
    <PageHero
      title="Witaj w Tailspin Toys"
      subtitle="Znajdź swoją następną grę. A może nawet ją wesprzesz? Przejrzyj naszą kolekcję!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Polecane gry</h2>

      {games.length === 0 ? (
        <EmptyState text="Na razie nie ma żadnych gier." />
      ) : (
        <>
          <GameFilters categories={categories} publishers={publishers} total={games.length} />
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div id="games-no-results" class="hidden">
            <EmptyState text="Żadna gra nie pasuje do wybranych filtrów." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>
